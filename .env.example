# Copy to .env and edit. Never commit .env.

# --- pack version ---
# PACK_VERSION is not set here. It comes from dist/cobblemon.env, which CI
# commits together with dist/cobblemon.mrpack, so `git pull` brings both.
# Compose reads it when the shell has COMPOSE_ENV_FILES=.env,dist/cobblemon.env;
# set that once in the profile of the account that runs the server (README).
# The scripts in scripts/ set it themselves.

# --- server ---
TZ=UTC
MC_PORT=25565
# Port of the staging stack (compose.staging.yaml), which runs next to production.
STAGING_PORT=25566
# Project name of the staging stack. It must be unique on the host: when two
# repositories made from this template share a host, give each its own, for
# example <your-repo>-staging.
STAGING_PROJECT_NAME=minecraft-staging
# Java heap. Production default assumes a host with at least 12 GB RAM.
# Use 4G on an 8 GB host, 3G for a local smoke test in a small Docker VM.
MEMORY=6G
MAX_PLAYERS=12
VIEW_DISTANCE=10
SIMULATION_DISTANCE=6
DIFFICULTY=normal
MODE=survival
PVP=false
# RCON is reachable only inside the compose network. Required, no default:
# generate with `openssl rand -base64 32`.
RCON_PASSWORD=

# --- backup (itzg/mc-backup sidecar, full tar archives into ./backups) ---
BACKUP_INTERVAL=24h
# Skip scheduled backups while nobody is online (nothing changed). Set false for test runs.
PAUSE_IF_NO_PLAYERS=true
# Archives older than this many days are deleted from the top level of ./backups.
# Put pre-upgrade archives in ./backups/keep/, which pruning never touches.
PRUNE_BACKUPS_DAYS=14

# --- ownership ---
# Host user and group ids. The server chowns data/ to them, the backup sidecar
# runs as them, and the tools container writes files as them.
# Linux: use the output of `id -u` and `id -g`. macOS: any value works.
UID=1000
GID=1000

# --- identity ---
# SERVER_NAME and SERVER_PUBLIC_HOST are not set here: they are public and live
# in the committed config/public.env. The server reads the name from
# dist/cobblemon.env, written with the pack.
