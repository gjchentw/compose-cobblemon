# Copy to .env and edit. Never commit .env.

# --- release ---
# Version of the pack the server installs from dist/ and announces in the MOTD.
# Must match pack/pack.toml; scripts/release.sh keeps them in step.
PACK_VERSION=1.0.0-rc.3

# --- server ---
TZ=UTC
MC_PORT=25565
# Port of the staging stack (compose.staging.yaml), which runs next to production.
STAGING_PORT=25566
# Java heap. Production default assumes a host with at least 12 GB RAM.
# Use 4G on an 8 GB host, 3G for a local smoke test in a small Docker VM.
MEMORY=6G
MAX_PLAYERS=12
VIEW_DISTANCE=10
SIMULATION_DISTANCE=6
DIFFICULTY=normal
MODE=survival
PVP=false
# RCON is reachable only inside the compose network. Required, no default:
# generate with `openssl rand -base64 32`.
RCON_PASSWORD=

# --- backup (itzg/mc-backup sidecar, full tar archives into ./backups) ---
BACKUP_INTERVAL=24h
# Skip scheduled backups while nobody is online (nothing changed). Set false for test runs.
PAUSE_IF_NO_PLAYERS=true
# Archives older than this many days are deleted from the top level of ./backups.
# Put pre-upgrade archives in ./backups/keep/, which pruning never touches.
PRUNE_BACKUPS_DAYS=14

# --- ownership ---
# Host user and group ids. The server chowns data/ to them, the backup sidecar
# runs as them, and the tools container writes files as them.
# Linux: use the output of `id -u` and `id -g`. macOS: any value works.
UID=1000
GID=1000

# --- identity (baked into the client pack's server list at export time) ---
# Players see SERVER_NAME in their Multiplayer list, pointing at SERVER_PUBLIC_HOST.
# Precedence when exporting: environment variable (CI: repository secrets), then .env, then this file.
SERVER_NAME=Cobblemon Server
SERVER_PUBLIC_HOST=mc.example.com
