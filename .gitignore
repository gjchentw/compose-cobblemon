# Secrets and local configuration
.env
.env.*
!.env.example

# Runtime data: world saves, backups, staging copies. Never committed.
data/
backups/
staging/

# Build outputs: the export build directory and anything else in dist/.
# The published pack and its version file are tracked; only CI commits them.
dist/*
!dist/cobblemon.mrpack
!dist/cobblemon.env
.build/

# Logs, caches and OS noise
*.log
__pycache__/
.DS_Store
